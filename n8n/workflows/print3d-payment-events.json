{
  "name": "print3d-payment-events",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "print3d-events",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [0, 0],
      "id": "2a6ef5e0-6dc1-4bcb-8cd1-000000000001",
      "name": "Print3D Events",
      "webhookId": "2a6ef5e0-6dc1-4bcb-8cd1-000000000002"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "confirmed",
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [{ "leftValue": "={{ $json.body.type }}", "rightValue": "payment.confirmed", "operator": { "type": "string", "operation": "equals" } }],
                "combinator": "and"
              }
            },
            {
              "outputKey": "refunded",
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [{ "leftValue": "={{ $json.body.type }}", "rightValue": "payment.refunded", "operator": { "type": "string", "operation": "equals" } }],
                "combinator": "and"
              }
            },
            {
              "outputKey": "cancelled",
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [{ "leftValue": "={{ $json.body.type }}", "rightValue": "payment.cancelled", "operator": { "type": "string", "operation": "equals" } }],
                "combinator": "and"
              }
            }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.5,
      "position": [220, 0],
      "id": "2a6ef5e0-6dc1-4bcb-8cd1-000000000003",
      "name": "Route payment event"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"accepted\", \"eventType\": $json.body.type, \"paymentId\": $json.body.payload.paymentId } }}",
        "options": { "responseCode": 202 }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [460, -120],
      "id": "2a6ef5e0-6dc1-4bcb-8cd1-000000000004",
      "name": "Accepted confirmed"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"accepted\", \"eventType\": $json.body.type, \"paymentId\": $json.body.payload.paymentId } }}",
        "options": { "responseCode": 202 }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [460, 0],
      "id": "2a6ef5e0-6dc1-4bcb-8cd1-000000000005",
      "name": "Accepted refunded"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"accepted\", \"eventType\": $json.body.type, \"paymentId\": $json.body.payload.paymentId } }}",
        "options": { "responseCode": 202 }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [460, 120],
      "id": "2a6ef5e0-6dc1-4bcb-8cd1-000000000006",
      "name": "Accepted cancelled"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"rejected\", \"reason\": \"unknown event type\", \"eventType\": $json.body.type } }}",
