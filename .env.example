# App
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Database
POSTGRES_USER=print3d
POSTGRES_PASSWORD=print3d
POSTGRES_DB=print3d
DATABASE_URL=postgresql://print3d:print3d@postgres:5432/print3d?schema=public

# Redis / Queue
REDIS_URL=redis://redis:6379
SLICING_QUEUE_NAME=slicing-jobs
SLICING_JOB_TIMEOUT_MS=600000

# Storage (MinIO/S3)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_PRIVATE=print3d-private
S3_FORCE_PATH_STYLE=true

# Auth
AUTH_SECRET=change-me-in-production
AUTH_URL=http://localhost:3000
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me

# DragonFruit (PoC)
DRAGONFRUIT_CLI_PATH=/usr/local/bin/dragonfruit
DRAGONFRUIT_MODE=auto # auto|cli|mock
DRAGONFRUIT_ALLOWED_PROFILES_DIR=/app/config/dragonfruit-profiles

# Payments (placeholder)
PAYMENT_PROVIDER=mock
MERCADOPAGO_ACCESS_TOKEN=

# n8n
N8N_WEBHOOK_SECRET=change-me
N8N_BASE_URL=http://n8n:5678
