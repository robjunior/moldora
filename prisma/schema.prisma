generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum QuoteStatus {
  DRAFT
  PROCESSING
  REVIEW
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
}

enum SlicingJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  auditLogs    AuditLog[]
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  company      String?
  document     String?  // CPF/CNPJ
  email        String?
  phone        String?
  address      String?
  notes        String?
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  files        File3D[]
  quotes       Quote[]
  orders       Order[]
}

model File3D {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  originalName String
  storageKey   String
  format       String   // STL, 3MF, OBJ
  sizeBytes    Int
  sha256       String?
  version      Int      @default(1)
  status       String   @default("UPLOADED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  slicingJobs  SlicingJob[]
  quoteItems   QuoteItem[]

  @@index([customerId])
  @@index([sha256])
}

model Printer {
  id        String   @id @default(cuid())
  name      String
  model     String?
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profiles  PrinterProfile[]
  slicingJobs SlicingJob[]
}

model Material {
  id            String   @id @default(cuid())
  name          String
  type          String   @default("RESIN")
  pricePerLiter Decimal  @db.Decimal(12, 4)
  currency      String   @default("BRL")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  slicingJobs   SlicingJob[]
  quoteItems    QuoteItem[]
}

model PrinterProfile {
  id          String   @id @default(cuid())
  printerId   String
  printer     Printer  @relation(fields: [printerId], references: [id])
  name        String
  configJson  Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slicingJobs SlicingJob[]

  @@index([printerId])
}

model SlicingJob {
  id               String           @id @default(cuid())
  fileId           String
  file             File3D           @relation(fields: [fileId], references: [id])
  printerId        String?
  printer          Printer?         @relation(fields: [printerId], references: [id])
  materialId       String?
  material         Material?        @relation(fields: [materialId], references: [id])
  profileId        String?
  profile          PrinterProfile?  @relation(fields: [profileId], references: [id])
  status           SlicingJobStatus @default(QUEUED)
  mode             String           @default("auto") // cli|mock|auto
  inputParams      Json?
  rawResult        Json?
  normalizedResult Json?
  errorMessage     String?
  startedAt        DateTime?
  finishedAt       DateTime?
  durationMs       Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  quoteItems       QuoteItem[]

  @@index([fileId])
  @@index([status])
}

model Quote {
  id             String      @id @default(cuid())
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])
  status         QuoteStatus @default(DRAFT)
  version        Int         @default(1)
  currency       String      @default("BRL")
  subtotal       Decimal?    @db.Decimal(12, 4)
  discount       Decimal?    @db.Decimal(12, 4)
  total          Decimal?    @db.Decimal(12, 4)
  marginRate     Decimal?    @db.Decimal(5, 4)
  validityUntil  DateTime?
  notes          String?
  snapshotJson   Json?       // immutable snapshot when sent/approved
  sentAt         DateTime?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          QuoteItem[]
  orders         Order[]

  @@index([customerId])
  @@index([status])
}

model QuoteItem {
  id            String      @id @default(cuid())
  quoteId       String
  quote         Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  fileId        String?
  file          File3D?     @relation(fields: [fileId], references: [id])
  slicingJobId  String?
  slicingJob    SlicingJob? @relation(fields: [slicingJobId], references: [id])
  materialId    String?
  material      Material?   @relation(fields: [materialId], references: [id])
  description   String?
  quantity      Int         @default(1)
  breakdownJson Json?       // memory of calculation
  unitPrice     Decimal?    @db.Decimal(12, 4)
  totalPrice    Decimal?    @db.Decimal(12, 4)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([quoteId])
}

model Order {
  id          String      @id @default(cuid())
  quoteId     String
  quote       Quote       @relation(fields: [quoteId], references: [id])
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  status      OrderStatus @default(PENDING)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  payments    Payment[]
  productionLogs ProductionLog[]

  @@index([quoteId])
  @@index([customerId])
  @@index([status])
}

model Payment {
  id                 String        @id @default(cuid())
  orderId            String
  order              Order         @relation(fields: [orderId], references: [id])
  provider           String
  providerPaymentId  String?
  status             PaymentStatus @default(PENDING)
  method             String?
  amount             Decimal       @db.Decimal(12, 4)
  currency           String        @default("BRL")
  idempotencyKey     String?       @unique
  rawResponse        Json?
  webhookEvents      Json?
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([orderId])
  @@index([provider, providerPaymentId])
}

model ProductionLog {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  message   String?
  actorId   String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
